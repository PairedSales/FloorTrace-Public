<Window x:Class="FloorTrace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloorTrace - Floor Plan Area Calculator" 
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        Icon="Assets/favicon.ico"
        Background="{StaticResource Background}">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteImageCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding LoadImageCommand}"/>
    </Window.InputBindings>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Material Design 3 Top App Bar -->
        <Border Grid.Row="0" 
                Background="{StaticResource Surface}" 
                Padding="16,8"
                Effect="{StaticResource Elevation2}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left side buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="Load Image" Style="{StaticResource TextButton}" Command="{Binding LoadImageCommand}"/>
                    <Rectangle Width="1" Height="24" Fill="{StaticResource OutlineVariant}" Margin="8,0"/>
                    <Button Content="Paste Image" Style="{StaticResource TextButton}" Command="{Binding PasteImageCommand}"/>
                </StackPanel>
                
                <!-- Center buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Detect Room" Style="{StaticResource TextButton}" Command="{Binding DetectRoomCommand}"/>
                    <Rectangle Width="1" Height="24" Fill="{StaticResource OutlineVariant}" Margin="8,0"/>
                    <Button Content="Trace Perimeter" Style="{StaticResource TextButton}" Command="{Binding TracePerimeterCommand}"/>
                    <Rectangle Width="1" Height="24" Fill="{StaticResource OutlineVariant}" Margin="8,0"/>
                    <Button Content="Manual Mode" Style="{StaticResource TextButton}" Command="{Binding ActivateManualModeCommand}"/>
                    <CheckBox Content="Use Inner Wall Edge" 
                              Style="{StaticResource MaterialCheckBox}"
                              IsChecked="{Binding UseInnerWallEdge}" 
                              VerticalAlignment="Center" 
                              Margin="16,0,0,0"
                              ToolTip="When enabled, the perimeter will trace along the inner edge of exterior walls, excluding wall thickness from the area calculation."/>
                </StackPanel>
                
                <!-- Right side buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Fit to Window" Style="{StaticResource TextButton}" Click="FitToWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="1" Background="{StaticResource Background}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Current Sketch Panel with Material Design Card -->
            <Border Grid.Column="0" 
                    Background="{StaticResource Surface}" 
                    CornerRadius="{StaticResource CornerRadiusMedium}"
                    Effect="{StaticResource Elevation2}">
                <Grid>
                    <!-- Status Badge (bottom-right) -->
                    <Border HorizontalAlignment="Right" 
                            VerticalAlignment="Bottom" 
                            Background="{StaticResource TertiaryContainer}"
                            CornerRadius="{StaticResource CornerRadiusSmall}"
                            Padding="12,6" 
                            Margin="16"
                            Effect="{StaticResource Elevation1}">
                        <TextBlock Text="Current Sketch" 
                                   Foreground="{StaticResource OnTertiaryContainer}"
                                   Style="{StaticResource LabelLarge}"/>
                    </Border>
                    
                    <!-- Canvas for floor plan image with pan and zoom -->
                    <Border Background="{StaticResource Background}" 
                            CornerRadius="{StaticResource CornerRadiusMedium}"
                            ClipToBounds="True"
                            Margin="8">
                        <ScrollViewer x:Name="ImageScrollViewer" 
                                     HorizontalScrollBarVisibility="Hidden" 
                                     VerticalScrollBarVisibility="Hidden"
                                     CanContentScroll="True"
                                     Background="{StaticResource Background}"
                                     PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel">
                            <!-- Large canvas to enable panning even when image is smaller than viewport -->
                            <Grid x:Name="PanningCanvas" Width="30000" Height="30000"
                                  Background="Transparent"
                                  MouseLeftButtonDown="PanningCanvas_MouseLeftButtonDown"
                                  MouseMove="PanningCanvas_MouseMove"
                                  MouseLeftButtonUp="PanningCanvas_MouseLeftButtonUp">
                                <Grid x:Name="ImageGrid" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center">
                                    <Grid.LayoutTransform>
                                        <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                                    </Grid.LayoutTransform>
                                    <Image x:Name="FloorPlanImage" 
                                           Source="{Binding CurrentImage}" 
                                           Stretch="None"/>
                                    <Canvas x:Name="OverlayCanvas" Background="Transparent"/>
                                    <Canvas x:Name="ManualHighlightsCanvas" Background="Transparent"/>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                    
                    <!-- Room Dimensions and Area Display - Material Design Card -->
                    <Border Background="{StaticResource SurfaceVariant}"
                            CornerRadius="{StaticResource CornerRadiusMedium}"
                            HorizontalAlignment="Left" 
                            VerticalAlignment="Top" 
                            Padding="16" 
                            Margin="12,16,16,16"
                            Effect="{StaticResource Elevation2}"
                            x:Name="DimensionsPanel">
                        <StackPanel MinWidth="160" HorizontalAlignment="Center">
                            <TextBlock Text="Room Dimensions" 
                                       Style="{StaticResource TitleMedium}"
                                       Margin="0,0,0,8"
                                       HorizontalAlignment="Center"/>
                            <TextBox x:Name="RoomDimensionsTextBox" 
                                     Width="160" 
                                     Height="32" 
                                     Margin="0,0,0,16"
                                     Style="{StaticResource OutlinedTextBox}"
                                     HorizontalAlignment="Center"
                                     TextAlignment="Center"
                                     Text="{Binding CurrentSketch.SelectedRoomForScale.Dimensions, UpdateSourceTrigger=PropertyChanged}"/>
                            
                            <TextBlock Text="Area" 
                                       Style="{StaticResource TitleMedium}"
                                       Margin="0,0,0,4"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding AreaText}" 
                                       Style="{StaticResource BodyLarge}"
                                       Foreground="{StaticResource Primary}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            
        </Grid>
    </Grid>
</Window>
