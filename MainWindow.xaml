<Window x:Class="FloorTrace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloorTrace - Floor Plan Area Calculator" 
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        Icon="Assets/favicon.ico">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteImageCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding LoadImageCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveSketchCommand}"/>
    </Window.InputBindings>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Top Buttons Panel -->
        <Border Grid.Row="0" Background="LightGray" Padding="10" BorderBrush="Black" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Load Image" Style="{StaticResource ButtonStyle}" Command="{Binding LoadImageCommand}"/>
                <Button Content="Paste Image" Style="{StaticResource ButtonStyle}" Command="{Binding PasteImageCommand}"/>
                <Button Content="Detect Room" Style="{StaticResource ButtonStyle}" Command="{Binding DetectRoomCommand}"/>
                <Button Content="Set Scale" Style="{StaticResource ButtonStyle}" Command="{Binding SetScaleCommand}"/>
                <Button Content="Trace Perimeter" Style="{StaticResource ButtonStyle}" Command="{Binding TracePerimeterCommand}"/>
                <Button Content="Calculate Area" Style="{StaticResource ButtonStyle}" Command="{Binding CalculateAreaCommand}"/>
                <Button Content="Save Sketch" Style="{StaticResource ButtonStyle}" Command="{Binding SaveSketchCommand}"/>
                <Button Content="Test" Style="{StaticResource ButtonStyle}" Command="{Binding LoadTestImageCommand}"/>
                
                <!-- Zoom Controls -->
                <Separator Margin="10,0"/>
                <Button Content="Zoom In" Style="{StaticResource ButtonStyle}" Click="ZoomIn_Click"/>
                <Button Content="Zoom Out" Style="{StaticResource ButtonStyle}" Click="ZoomOut_Click"/>
                <Button Content="Reset Zoom" Style="{StaticResource ButtonStyle}" Click="ResetZoom_Click"/>
                <Button Content="Fit to Window" Style="{StaticResource ButtonStyle}" Click="FitToWindow_Click"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Current Sketch Panel -->
            <Border Grid.Column="0" Background="White" BorderBrush="Black" BorderThickness="1,0,0,0">
                <Grid>
                    <Border Background="LightBlue" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                            Padding="10" Margin="10" BorderBrush="Black" BorderThickness="1">
                        <TextBlock Text="Current Sketch" FontWeight="Bold"/>
                    </Border>
                    
                    <!-- Canvas for floor plan image with pan and zoom -->
                    <Border Background="White" ClipToBounds="True">
                        <ScrollViewer x:Name="ImageScrollViewer" 
                                     HorizontalScrollBarVisibility="Hidden" 
                                     VerticalScrollBarVisibility="Hidden"
                                     CanContentScroll="True"
                                     Background="White"
                                     PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel">
                            <!-- Large canvas to enable panning even when image is smaller than viewport -->
                            <Grid x:Name="PanningCanvas" Width="30000" Height="30000"
                                  Background="Transparent"
                                  MouseLeftButtonDown="PanningCanvas_MouseLeftButtonDown"
                                  MouseMove="PanningCanvas_MouseMove"
                                  MouseLeftButtonUp="PanningCanvas_MouseLeftButtonUp">
                                <Grid x:Name="ImageGrid" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center">
                                    <Grid.LayoutTransform>
                                        <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                                    </Grid.LayoutTransform>
                                    <Image x:Name="FloorPlanImage" 
                                           Source="{Binding CurrentImage}" 
                                           Stretch="None"/>
                                    <Canvas x:Name="OverlayCanvas" Background="Transparent"/>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                    
                    <!-- Room Dimensions Input -->
                    <Border Background="LightBlue" HorizontalAlignment="Left" VerticalAlignment="Top" 
                            Padding="10" Margin="10" BorderBrush="Black" BorderThickness="1"
                            x:Name="DimensionsPanel">
                        <StackPanel>
                            <TextBlock Text="Room Dimensions:" FontWeight="Bold" FontSize="14"/>
                            <TextBox x:Name="RoomDimensionsTextBox" Width="200" Height="25" Margin="0,5,0,0"
                                     Text="{Binding CurrentSketch.SelectedRoomForScale.Dimensions, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>

                    <!-- Results Display -->
                    <Border Background="LightYellow" HorizontalAlignment="Left" VerticalAlignment="Top" 
                            Padding="10" Margin="10,80,10,10" BorderBrush="Black" BorderThickness="1"
                            Visibility="{Binding IsResultsPanelVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Results" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding ScaleText}" Margin="0,2"/>
                            <TextBlock Text="{Binding SideLengthsText}" Margin="0,2"/>
                            <TextBlock Text="{Binding AreaText}" Margin="0,2"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            
            <!-- Separator -->
            <GridSplitter Grid.Column="1" Width="5" Background="Gray" HorizontalAlignment="Stretch"/>
            
            <!-- Prior Sketches Panel -->
            <Border Grid.Column="2" Background="LightGray" BorderBrush="Black" BorderThickness="0,0,0,0">
                <Grid>
                    <TextBlock Text="Prior Sketches" FontWeight="Bold" FontSize="16" 
                               HorizontalAlignment="Center" VerticalAlignment="Top" 
                               Margin="10" Background="LightGray" Padding="10"/>
                    
                    <!-- List of prior sketches -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,50,10,10">
                        <ItemsControl ItemsSource="{Binding PriorSketches}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" Margin="5" Padding="5" 
                                            BorderBrush="Black" BorderThickness="1">
                                        <StackPanel>
                                            <Image Source="{Binding Thumbnail}" Height="80" Stretch="Uniform"/>
                                            <TextBlock Text="{Binding Name}" FontSize="10" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding DateCreated}" FontSize="8" Foreground="Gray"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
