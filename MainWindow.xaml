<Window x:Class="FloorTrace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloorTrace - Floor Plan Area Calculator" 
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        Icon="Assets/favicon.ico">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteImageCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding LoadImageCommand}"/>
    </Window.InputBindings>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Top Buttons Panel -->
        <Border Grid.Row="0" Background="LightGray" Padding="10" BorderBrush="Black" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Load Image" Style="{StaticResource ButtonStyle}" Command="{Binding LoadImageCommand}"/>
                <Button Content="Paste Image" Style="{StaticResource ButtonStyle}" Command="{Binding PasteImageCommand}"/>
                <Button Content="Detect Room" Style="{StaticResource ButtonStyle}" Command="{Binding DetectRoomCommand}"/>
                <Button Content="Trace Perimeter" Style="{StaticResource ButtonStyle}" Command="{Binding TracePerimeterCommand}"/>
                <CheckBox Content="Use Inner Wall Edge" 
                          IsChecked="{Binding UseInnerWallEdge}" 
                          VerticalAlignment="Center" 
                          Margin="10,0,0,0"
                          ToolTip="When enabled, the perimeter will trace along the inner edge of exterior walls, excluding wall thickness from the area calculation."/>
                <!-- Test button - visible only in DEBUG builds -->
                <Button Content="Test" Style="{StaticResource ButtonStyle}" Command="{Binding LoadTestImageCommand}" x:Name="TestButton"/>
                
                <!-- Zoom Controls -->
                <Separator Margin="10,0"/>
                <Button Content="Fit to Window" Style="{StaticResource ButtonStyle}" Click="FitToWindow_Click"/>
                
            </StackPanel>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Current Sketch Panel -->
            <Border Grid.Column="0" Background="White" BorderBrush="Black" BorderThickness="1,0,0,0">
                <Grid>
                    <Border Background="LightBlue" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                            Padding="10" Margin="10" BorderBrush="Black" BorderThickness="1">
                        <TextBlock Text="Current Sketch" FontWeight="Bold"/>
                    </Border>
                    
                    <!-- Canvas for floor plan image with pan and zoom -->
                    <Border Background="White" ClipToBounds="True">
                        <ScrollViewer x:Name="ImageScrollViewer" 
                                     HorizontalScrollBarVisibility="Hidden" 
                                     VerticalScrollBarVisibility="Hidden"
                                     CanContentScroll="True"
                                     Background="White"
                                     PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel">
                            <!-- Large canvas to enable panning even when image is smaller than viewport -->
                            <Grid x:Name="PanningCanvas" Width="30000" Height="30000"
                                  Background="Transparent"
                                  MouseLeftButtonDown="PanningCanvas_MouseLeftButtonDown"
                                  MouseMove="PanningCanvas_MouseMove"
                                  MouseLeftButtonUp="PanningCanvas_MouseLeftButtonUp">
                                <Grid x:Name="ImageGrid" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center">
                                    <Grid.LayoutTransform>
                                        <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                                    </Grid.LayoutTransform>
                                    <Image x:Name="FloorPlanImage" 
                                           Source="{Binding CurrentImage}" 
                                           Stretch="None"/>
                                    <Canvas x:Name="OverlayCanvas" Background="Transparent"/>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                    
                    <!-- Room Dimensions and Area Display -->
                    <Border Background="LightGray" HorizontalAlignment="Left" VerticalAlignment="Top" 
                            Padding="10" Margin="0" BorderBrush="Black" BorderThickness="0,0,1,1"
                            x:Name="DimensionsPanel">
                        <StackPanel>
                            <TextBlock Text="Room Dimensions:" FontWeight="Bold" FontSize="14"/>
                            <TextBox x:Name="RoomDimensionsTextBox" Width="120" Height="25" Margin="0,5,0,10"
                                     FontSize="14"
                                     Text="{Binding CurrentSketch.SelectedRoomForScale.Dimensions, UpdateSourceTrigger=PropertyChanged}"/>
                            
                            <TextBlock Text="Area:" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding AreaText}" FontSize="14" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            
        </Grid>
    </Grid>
</Window>
