<Application x:Class="FloorTrace.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Material Design 3 Color System -->
        <!-- Light Mode Colors (Default) -->
        <!-- Primary Colors (Indigo) -->
        <SolidColorBrush x:Key="Primary" Color="#3F51B5"/>
        <SolidColorBrush x:Key="PrimaryContainer" Color="#E8EAF6"/>
        <SolidColorBrush x:Key="OnPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="OnPrimaryContainer" Color="#1A237E"/>
        
        <!-- Secondary Colors (Blue) -->
        <SolidColorBrush x:Key="Secondary" Color="#2196F3"/>
        <SolidColorBrush x:Key="SecondaryContainer" Color="#E3F2FD"/>
        <SolidColorBrush x:Key="OnSecondary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="OnSecondaryContainer" Color="#0D47A1"/>
        
        <!-- Tertiary Colors (Teal) -->
        <SolidColorBrush x:Key="Tertiary" Color="#009688"/>
        <SolidColorBrush x:Key="TertiaryContainer" Color="#E0F2F1"/>
        <SolidColorBrush x:Key="OnTertiary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="OnTertiaryContainer" Color="#004D40"/>
        
        <!-- Surface Colors (Light Mode) -->
        <SolidColorBrush x:Key="Surface" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="SurfaceVariant" Color="#EEEEEE"/>
        <SolidColorBrush x:Key="Background" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="OnSurface" Color="#212121"/>
        <SolidColorBrush x:Key="OnSurfaceVariant" Color="#616161"/>
        <SolidColorBrush x:Key="Outline" Color="#BDBDBD"/>
        <SolidColorBrush x:Key="OutlineVariant" Color="#E0E0E0"/>
        
        
        <!-- State Layer Colors (Light Mode) -->
        <SolidColorBrush x:Key="HoverOverlay" Color="#0A000000"/>
        <SolidColorBrush x:Key="PressedOverlay" Color="#1A000000"/>
        <SolidColorBrush x:Key="FocusOverlay" Color="#1F3F51B5"/>
        
        
        <!-- Material Design 3 Elevation System (Shadows - Light Mode) -->
        <DropShadowEffect x:Key="Elevation1" BlurRadius="2" ShadowDepth="1" Opacity="0.15" Color="#000000"/>
        <DropShadowEffect x:Key="Elevation2" BlurRadius="4" ShadowDepth="2" Opacity="0.18" Color="#000000"/>
        <DropShadowEffect x:Key="Elevation3" BlurRadius="8" ShadowDepth="3" Opacity="0.20" Color="#000000"/>
        <DropShadowEffect x:Key="Elevation4" BlurRadius="12" ShadowDepth="4" Opacity="0.22" Color="#000000"/>
        <DropShadowEffect x:Key="Elevation5" BlurRadius="16" ShadowDepth="5" Opacity="0.24" Color="#000000"/>
        
        
        <!-- Material Design 3 Corner Radius -->
        <CornerRadius x:Key="CornerRadiusSmall">8</CornerRadius>
        <CornerRadius x:Key="CornerRadiusMedium">12</CornerRadius>
        <CornerRadius x:Key="CornerRadiusLarge">16</CornerRadius>
        <CornerRadius x:Key="CornerRadiusFull">9999</CornerRadius>
        
        <!-- Material Design 3 Button Styles -->
        
        <!-- Filled Button (Primary) -->
        <Style x:Key="FilledButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="{StaticResource OnPrimary}"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource CornerRadiusLarge}"
                                Effect="{StaticResource Elevation1}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Effect" Value="{StaticResource Elevation1}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Tonal Button (Secondary) -->
        <Style x:Key="TonalButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SecondaryContainer}"/>
            <Setter Property="Foreground" Value="{StaticResource OnSecondaryContainer}"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource CornerRadiusLarge}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Effect" Value="{StaticResource Elevation1}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Outlined Button -->
        <Style x:Key="OutlinedButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource CornerRadiusLarge}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource HoverOverlay}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Text Button -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource CornerRadiusLarge}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource OnPrimaryContainer}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.38"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Default Button Style (use Filled) -->
        <Style x:Key="ButtonStyle" TargetType="Button" BasedOn="{StaticResource FilledButton}"/>
        
        <!-- Material Design 3 Card Styles -->
        <Style x:Key="ElevatedCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}"/>
            <Setter Property="Effect" Value="{StaticResource Elevation2}"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        
        <Style x:Key="FilledCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceVariant}"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        
        <!-- Material Design 3 TextBox Style -->
        <Style x:Key="OutlinedTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CaretBrush" Value="{StaticResource Primary}"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Material Design 3 CheckBox Style -->
        <Style x:Key="MaterialCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBoxBorder"
                                    Width="20" Height="20"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource Outline}"
                                    BorderThickness="2"
                                    CornerRadius="4"
                                    Margin="0,0,8,0">
                                <Path x:Name="CheckMark"
                                      Data="M 2,6 L 6,10 L 14,2"
                                      Stroke="{StaticResource OnPrimary}"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{StaticResource Primary}"/>
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Effect" Value="{StaticResource Elevation1}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Material Design 3 Typography -->
        <Style x:Key="DisplayLarge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="57"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
        </Style>
        
        <Style x:Key="HeadlineMedium" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
        </Style>
        
        <Style x:Key="TitleLarge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
        </Style>
        
        <Style x:Key="TitleMedium" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
        </Style>
        
        <Style x:Key="BodyLarge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
        </Style>
        
        <Style x:Key="BodyMedium" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
        </Style>
        
        <Style x:Key="LabelLarge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
        </Style>
    </Application.Resources>
</Application>
