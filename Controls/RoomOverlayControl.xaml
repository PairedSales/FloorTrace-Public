<UserControl x:Class="FloorTrace.Controls.RoomOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="160" IsHitTestVisible="True">
    <Grid>
        <Rectangle Stroke="#66FF9800" StrokeThickness="3" Fill="#11FF9800" RadiusX="2" RadiusY="2"/>
        <TextBox x:Name="DimensionText"
                 Width="120" Height="24"
                 Margin="6" VerticalAlignment="Top" HorizontalAlignment="Left"
                 Background="#CCFFFFFF" BorderBrush="#FF666666" BorderThickness="1"/>

        <!-- Move thumb -->
        <Thumb x:Name="MoveThumb" Cursor="SizeAll" Background="Transparent"/>

        <!-- Corner thumbs -->
        <Canvas>
            <Thumb x:Name="TopLeft" Width="10" Height="10" Background="#FF2196F3" Cursor="SizeNWSE"
                   Canvas.Left="-5" Canvas.Top="-5"/>
            <Thumb x:Name="TopRight" Width="10" Height="10" Background="#FF2196F3" Cursor="SizeNESW"
                   Canvas.Right="-5" Canvas.Top="-5"/>
            <Thumb x:Name="BottomLeft" Width="10" Height="10" Background="#FF2196F3" Cursor="SizeNESW"
                   Canvas.Left="-5" Canvas.Bottom="-5"/>
            <Thumb x:Name="BottomRight" Width="10" Height="10" Background="#FF2196F3" Cursor="SizeNWSE"
                   Canvas.Right="-5" Canvas.Bottom="-5"/>
        </Canvas>
    </Grid>
</UserControl>



