<UserControl x:Class="FloorTrace.Controls.RoomOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="160" IsHitTestVisible="True">
    <Grid>
        <!-- Green transparent room overlay -->
        <Rectangle Stroke="#FF00FF00" StrokeThickness="1" Fill="#3000FF00" RadiusX="2" RadiusY="2"/>

        <!-- Move thumb for dragging the overlay -->
        <Thumb x:Name="MoveThumb" Cursor="SizeAll" Background="Transparent" Opacity="0"/>

        <!-- Corner thumbs for resizing -->
        <Canvas>
            <Thumb x:Name="TopLeft" Width="10" Height="10" Background="#FF00FF00" Cursor="SizeNWSE"
                   Canvas.Left="-5" Canvas.Top="-5"/>
            <Thumb x:Name="TopRight" Width="10" Height="10" Background="#FF00FF00" Cursor="SizeNESW"
                   Canvas.Right="-5" Canvas.Top="-5"/>
            <Thumb x:Name="BottomLeft" Width="10" Height="10" Background="#FF00FF00" Cursor="SizeNESW"
                   Canvas.Left="-5" Canvas.Bottom="-5"/>
            <Thumb x:Name="BottomRight" Width="10" Height="10" Background="#FF00FF00" Cursor="SizeNWSE"
                   Canvas.Right="-5" Canvas.Bottom="-5"/>
        </Canvas>
    </Grid>
</UserControl>



