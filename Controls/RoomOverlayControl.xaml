<UserControl x:Class="FloorTrace.Controls.RoomOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="160" IsHitTestVisible="True">
    <Grid>
        <!-- Material Design 3 Room Overlay with Primary Color -->
        <Rectangle Stroke="{DynamicResource Primary}" 
                   StrokeThickness="2" 
                   Fill="{DynamicResource Primary}" 
                   Opacity="0.3"
                   RadiusX="8" 
                   RadiusY="8">
            <Rectangle.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- Move thumb for dragging the overlay -->
        <Thumb x:Name="MoveThumb" Cursor="SizeAll" Background="Transparent" Opacity="0"/>

        <!-- Corner thumbs for resizing - Material Design styled Thumbs -->
        <Canvas>
            <!-- Top Left -->
            <Thumb x:Name="TopLeft" 
                   Width="12" Height="12" 
                   Cursor="SizeNWSE"
                   Canvas.Left="-6" Canvas.Top="-6">
                <Thumb.Template>
                    <ControlTemplate>
                        <Ellipse Fill="{DynamicResource Primary}" 
                                 Stroke="White" 
                                 StrokeThickness="2">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" Color="#000000"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            
            <!-- Top Right -->
            <Thumb x:Name="TopRight" 
                   Width="12" Height="12" 
                   Cursor="SizeNESW"
                   Canvas.Right="-6" Canvas.Top="-6">
                <Thumb.Template>
                    <ControlTemplate>
                        <Ellipse Fill="{DynamicResource Primary}" 
                                 Stroke="White" 
                                 StrokeThickness="2">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" Color="#000000"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            
            <!-- Bottom Left -->
            <Thumb x:Name="BottomLeft" 
                   Width="12" Height="12" 
                   Cursor="SizeNESW"
                   Canvas.Left="-6" Canvas.Bottom="-6">
                <Thumb.Template>
                    <ControlTemplate>
                        <Ellipse Fill="{DynamicResource Primary}" 
                                 Stroke="White" 
                                 StrokeThickness="2">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" Color="#000000"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            
            <!-- Bottom Right -->
            <Thumb x:Name="BottomRight" 
                   Width="12" Height="12" 
                   Cursor="SizeNESW"
                   Canvas.Right="-6" Canvas.Bottom="-6">
                <Thumb.Template>
                    <ControlTemplate>
                        <Ellipse Fill="{DynamicResource Primary}" 
                                 Stroke="White" 
                                 StrokeThickness="2">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" Color="#000000"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Canvas>
    </Grid>
</UserControl>



